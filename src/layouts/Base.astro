---
import "../styles/global.css";
const { title = "minimi, a concept redesign by Maninder Singh" } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
